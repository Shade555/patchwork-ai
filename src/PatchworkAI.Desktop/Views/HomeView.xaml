<UserControl x:Class="PatchworkAI.Desktop.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            
            <!-- Hero Header -->
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="Patchwork AI" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="Native Windows Document Repair Assistant • Local-first, private spreadsheet repair with open-weight AI." 
                           FontSize="14" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Quick Action Cards Grid -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Card 1: Import Document -->
                <ui:Card Grid.Column="0" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Import Spreadsheet" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Select a messy CSV or XLSX file from your computer. Your original file remains completely safe and untouched." 
                                   TextWrapping="Wrap" Margin="0,8,0,16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" />
                        <Button Content="Choose File..." 
                                Style="{DynamicResource AccentButtonStyle}"
                                Command="{Binding BrowseAndImportFileCommand}"
                                HorizontalAlignment="Left" Padding="16,8" />
                    </StackPanel>
                </ui:Card>

                <!-- Card 2: Demonstration Mode -->
                <ui:Card Grid.Column="2" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Demonstration Dataset" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Load a synthetic supplier inventory catalog with 10 intentional real-world business error scenarios in one click." 
                                   TextWrapping="Wrap" Margin="0,8,0,16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" />
                        <Button Content="Load Sample Dataset" 
                                Command="{Binding LoadSampleDatasetCommand}"
                                HorizontalAlignment="Left" Padding="16,8" />
                    </StackPanel>
                </ui:Card>
            </Grid>

            <!-- Status & Privacy Cards Grid -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Local AI Runtime Card -->
                <ui:Card Grid.Column="0" Padding="20">
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="Local AI Runtime" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Border DockPanel.Dock="Right" CornerRadius="12" Padding="10,2"
                                    Background="{Binding ModelStatus.IsAvailable, Converter={StaticResource StatusToBrushConverter}}">
                                <TextBlock Text="{Binding ModelStatus.IsAvailable, Converter={StaticResource BoolToStatusTextConverter}}" 
                                           Foreground="White" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </DockPanel>

                        <TextBlock Text="Endpoint: http://localhost:11434 (Ollama)" Margin="0,10,0,2" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding ModelStatus.ConfiguredModel, StringFormat='Configured Model: {0}'}" Margin="0,0,0,12" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Check Connection" Command="{Binding CheckOllamaStatusCommand}" Margin="0,0,8,0" Padding="12,6" />
                            <Button Content="Configure..." Command="{Binding NavigateCommand}" CommandParameter="Settings" Padding="12,6" />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <!-- Privacy Model Card -->
                <ui:Card Grid.Column="2" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Local-First Privacy Architecture" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="• Zero Cloud Uploads: Processing occurs entirely in local memory." Margin="0,8,0,2" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="• No Telemetry: No spreadsheet contents or metrics leave your device." Margin="0,0,0,2" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="• Non-Destructive: Original source files are opened read-only." Margin="0,0,0,2" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="• Air-Gapped AI: Local open-weight LLMs via localhost runtime." Margin="0,0,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:Card>
            </Grid>

            <!-- Most Recent Activity / Current Dataset Summary -->
            <ui:Card Padding="20" Visibility="{Binding HasActiveDataset, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Active Dataset Session" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding CurrentDataset.FileName, StringFormat='File: {0}'}" FontWeight="Medium" Margin="0,6,0,2" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Margin="0,0,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12">
                        <Run Text="Rows: " /><Run Text="{Binding CurrentDataset.TotalRows, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="   •   Columns: " /><Run Text="{Binding CurrentDataset.TotalColumns, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="   •   Issues Detected: " /><Run Text="{Binding TotalIssuesCount, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="   •   Pending Fixes: " /><Run Text="{Binding PendingTransformationsCount, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="View &amp; Inspect Dataset" Command="{Binding NavigateCommand}" CommandParameter="Import" Margin="0,0,8,0" Style="{DynamicResource AccentButtonStyle}" Padding="12,6" />
                        <Button Content="Review Proposed Fixes" Command="{Binding NavigateCommand}" CommandParameter="Review" Padding="12,6" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>
