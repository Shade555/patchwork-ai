<UserControl x:Class="PatchworkAI.Desktop.Views.ExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="950">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Export Action & Completion Report Card -->
            <RowDefinition Height="Auto" />
            <!-- Session Change Log Table -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Section: Export Trigger Card & Completion Report -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            
            <!-- Export Trigger Card -->
            <ui:Card Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Export Repaired Spreadsheet" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Save your cleaned, repaired dataset to a new file. The original source file is guaranteed to remain completely unchanged." 
                                   Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Export as CSV (.csv)" 
                                Command="{Binding ExportRepairedDatasetCommand}" CommandParameter="CSV"
                                Padding="16,8" Margin="0,0,10,0" />
                        <Button Content="Export as Excel (.xlsx)" 
                                Style="{DynamicResource AccentButtonStyle}"
                                Command="{Binding ExportRepairedDatasetCommand}" CommandParameter="XLSX"
                                Padding="16,8" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- Completion Report Card (Displayed after export) -->
            <ui:Card Padding="20" Background="#1422C55E" BorderBrush="#22C55E" BorderThickness="1"
                     Visibility="{Binding LastExportReport, Converter={StaticResource NullOrEmptyToVisibilityConverter}}">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="✓ Export Succeeded &amp; Verified" FontSize="16" FontWeight="SemiBold" Foreground="#22C55E" />
                        <Button DockPanel.Dock="Right" Content="Open Containing Folder" 
                                Command="{Binding OpenExportFolderCommand}" Padding="12,6" />
                    </DockPanel>

                    <!-- Key Metrics Grid -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Output Location:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding LastExportReport.ExportPath}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="12" FontFamily="Consolas" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Approved Fixes Applied:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding LastExportReport.ApprovedFixesCount}" FontWeight="Bold" FontSize="15" Foreground="#22C55E" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Rejected Suggestions:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding LastExportReport.RejectedSuggestionsCount}" FontWeight="Bold" FontSize="15" Foreground="#EF4444" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Cells / Rows Modified:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock FontSize="15" FontWeight="Bold" Margin="0,2,0,0">
                                <Run Text="{Binding LastExportReport.AffectedCellsCount, Mode=OneWay}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Run Text=" cells / " Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                                <Run Text="{Binding LastExportReport.AffectedRowsCount, Mode=OneWay}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Run Text=" rows" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ui:Card>
        </StackPanel>

        <!-- Bottom Section: Session Change Log -->
        <ui:Card Grid.Row="1" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Session Change Log &amp; Audit Trail" FontSize="15" FontWeight="SemiBold" 
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,12" />

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding ChangeLogEntries}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="1"
                          BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                          Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" Width="90" />
                        <DataGridTextColumn Header="Row" Binding="{Binding RowIndex}" Width="55" />
                        <DataGridTextColumn Header="Column" Binding="{Binding ColumnName}" Width="120" />
                        <DataGridTextColumn Header="Previous Value" Binding="{Binding PreviousValue}" Width="1.5*" />
                        <DataGridTextColumn Header="New Cleaned Value" Binding="{Binding NewValue}" Width="1.5*" />
                        <DataGridTextColumn Header="Rule / Reason" Binding="{Binding RuleApplied}" Width="2*" />
                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="95" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </ui:Card>
    </Grid>
</UserControl>
